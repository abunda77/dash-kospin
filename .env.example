APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Webhook Configuration
WEBHOOK_URL_BARCODE_TABUNGAN=

# WhatsApp Gateway Configuration
# REST API gateway berbasis go-whatsapp-web-multidevice
# Referensi: WHATSAPPGATEWAY.md poin 4 — API Reference
WHATSAPP_AUTH=
WHATSAPP_IP=
WHATSAPP_PORT=3003
WHATSAPP_DEVICE_ID=
WHATSAPP_ACTION=stop
WHATSAPP_DURATION=86400
WEBHOOK_WA_N8N=

WA_GATEWAY_URL=
WA_GATEWAY_USERNAME=
WA_GATEWAY_PASSWORD=
WA_GATEWAY_DEVICE_ID=
WA_ADMIN_NOTIF_NUMBER=
WA_GATEWAY_TIMEOUT=

SETORAN_DURASI_QRIS_MENIT=30
SETORAN_MINIMAL=10000
SETORAN_MAKSIMAL=100000000
SETORAN_BATAS_AKTIF=1
SETORAN_DUAL_APPROVAL_NOMINAL=1000000
